{
  "folders": [
    {
      "name": "🎬 Frontend (Flutter)",
      "path": "./frontend"
    },
    {
      "name": "⚙️  Backend (Node.js)",
      "path": "./backend"
    },
    {
      "name": "🗂️  Legacy (OTP Server)",
      "path": "./legacy/otp-server"
    },
    {
      "name": "📚 Docs",
      "path": "./docs"
    },
    {
      "name": "🌳 Root",
      "path": "."
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "files.trimTrailingWhitespace": true,
    "search.exclude": {
      "**/node_modules": true,
      "**/build": true,
      "**/.dart_tool": true,
      "**/frontend/.pub": true
    },
    "[dart]": {
      "editor.tabSize": 2,
      "editor.formatOnSave": true
    },
    "[javascript]": {
      "editor.tabSize": 2,
      "editor.formatOnSave": true
    }
  },
  "extensions": {
    "recommendations": [
      "Dart-Code.dart-code",
      "Dart-Code.flutter",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-node-azure-pack"
    ]
  }
}
