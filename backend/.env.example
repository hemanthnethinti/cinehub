# Local development defaults. Replace every secret before deploying.
NODE_ENV=development
PORT=5000

APP_NAME=CineHub
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
API_PREFIX=/api

# `docker compose up -d` from the repository root starts these services.
MONGODB_URI=mongodb://127.0.0.1:27017/cinehub
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Development-only values. Generate unique random secrets for production.
JWT_ACCESS_SECRET=development-only-access-secret-change-before-production
JWT_REFRESH_SECRET=development-only-refresh-secret-change-before-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# AI features are disabled when both keys are empty; the rest of the API works.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_PROVIDER=gemini

# Optional email integration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Local media storage is the default.
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=cinehub-media
